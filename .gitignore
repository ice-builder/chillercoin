# ChillerCoin public repository — minimal ignore list
# Do not list private monorepo / trading-engine paths here (metadata leak).

# Secrets / keys
.env
.env.*
!.env.example
.deploy.env
**/.deploy.env
**/*-keypair.json
**/id.json
*.pem
*.key
*.wallet
secrets.*
config.local.*

# Build / deps
target/
node_modules/
dist/
build/
.anchor/
test-ledger/
*.so
!chiller-vault/tests/fixtures/*.so

# Python / local
__pycache__/
*.pyc
.venv/
venv/
*.db
*.sqlite3

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs / runtime
*.log
reports/
